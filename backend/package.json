{
  "name": "orwickle-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "verify:db": "node --env-file-if-exists=.env scripts/verify-db.js",
    "storage:setup": "node --env-file-if-exists=.env scripts/setup-storage.js",
    "verify:auth:live": "node --env-file=.env scripts/verify-auth-live.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "imapflow": "^2.5.8",
    "mailparser": "^3.10.0",
    "supertest": "^7.3.1"
  }
}
