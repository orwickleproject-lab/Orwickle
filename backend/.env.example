NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime URI uses orwickle_app.PROJECT_REF, never the postgres owner.
# Keep the owner URI separately in ignored .env.migrations for setup only.
# Leave empty to run the API while account setup is pending (readiness returns 503).
# No URL query parameters: TLS is configured explicitly with verification enabled.
DATABASE_URL=
# Example shape only: postgresql://orwickle_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
# Download the Supabase root CA to this ignored path; see the root README.
# Paths are relative to backend/. Leave empty only for an already trusted CA.
# Certificate and hostname verification must stay enabled.
DATABASE_SSL_CA_FILE=.secrets/supabase-ca.crt

# Independent random secrets (at least 64 characters). migrate-auth generates these locally.
SESSION_SECRET=
OTP_PEPPER=
ADMIN_ORIGIN=http://localhost:5173

# Real email sender: scripts/configure-email.ps1 accepts a Google app password locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orwickleproject@gmail.com
SMTP_PASSWORD=
MAIL_FROM=orwickleproject@gmail.com
